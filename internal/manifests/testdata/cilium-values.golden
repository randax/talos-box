ipam:
  mode: kubernetes
kubeProxyReplacement: true
k8sServiceHost: localhost
k8sServicePort: 7445
securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup
l2announcements:
  enabled: true
bgpControlPlane:
  enabled: true
k8sClientRateLimit:
  qps: 8
  burst: 10
ingressController:
  enabled: true
  default: true
  loadbalancerMode: shared
  service:
    annotations:
      lbipam.cilium.io/ips: 172.30.0.200
