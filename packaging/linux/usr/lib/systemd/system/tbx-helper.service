[Unit]
Description=Talos Box privileged helper
# A helper started by hand still gets the socket's descriptor; without this a
# `systemctl start tbx-helper.service` before the socket is enabled would try
# to bind under /run/user/<tbx-uid>, which a nologin system user never has.
Requires=tbx-helper.socket
After=tbx-helper.socket

[Service]
ExecStart=/usr/bin/tbx-helper
Environment=TBX_HELPER_SOCKET=/var/run/tbx-helper.sock
User=tbx
Group=tbx
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
StateDirectory=tbx
StateDirectoryMode=0700
NoNewPrivileges=yes
DynamicUser=no
PrivateNetwork=no
ProtectSystem=strict
# The helper never reads a user's home: cluster state reaches it over net.sync.
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
DeviceAllow=/dev/net/tun rw
