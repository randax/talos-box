[Unit]
Description=Talos Box privileged helper

[Service]
# "+" runs as root regardless of User=/capabilities; "-" tolerates a source
# install that skipped the drop-in (the helper then reports the sysctl itself).
ExecStartPre=-+/usr/lib/systemd/systemd-sysctl /usr/lib/sysctl.d/50-talos-box.conf
ExecStart=/usr/bin/tbx-helper
User=tbx
Group=tbx
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
StateDirectory=tbx
StateDirectoryMode=0700
NoNewPrivileges=yes
DynamicUser=no
PrivateNetwork=no
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
DeviceAllow=/dev/net/tun rw
